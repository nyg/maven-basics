<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.self.nyg</groupId>
    <artifactId>maven-basics</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <description>A simple application to play with Maven features.</description>
    <url>https://github.com/nyg/maven-basics</url>

    <scm>
        <url>https://github.com/nyg/maven-basics</url>
        <connection>scm:git:https://github.com/nyg/maven-basics.git</connection>
        <developerConnection>scm:git:git@github.com:nyg/maven-basics.git</developerConnection>
    </scm>

    <contributors>
        <contributor>
            <name>nyg</name>
            <roles>
                <role>Developer</role>
            </roles>
        </contributor>
    </contributors>

    <licenses>
        <license>
            <name>MIT</name>
            <distribution>manual</distribution>
        </license>
    </licenses>

    <properties>
        <!-- Specify the source encoding, used by multiple plugins -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- User property for the maven-compiler-plugin, defines the Java
             version to use. It can also be put directly in the plugin
             configuration -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Plugins -->
        <compiler.plugin.version>3.10.1</compiler.plugin.version>
        <jar.plugin.version>3.3.0</jar.plugin.version>
        <site.plugin.version>4.0.0-M4</site.plugin.version>
        <reports.plugin.version>3.4.1</reports.plugin.version>
        <javadoc.plugin.version>3.4.1</javadoc.plugin.version>
        <buildplan.plugin.version>2.2.1</buildplan.plugin.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <!-- https://github.com/apache/maven-compiler-plugin/releases -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- https://github.com/apache/maven-jar-plugin/releases -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${jar.plugin.version}</version>
                    <configuration>
                        <!-- needed to make the jar executable with:
                             java -jar target/*.jar -->
                        <archive>
                            <manifest>
                                <mainClass>edu.self.nyg.maven.basics.Main</mainClass>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>

                <!-- Site generation plugins -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${site.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-project-info-reports-plugin</artifactId>
                    <version>${reports.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${javadoc.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>buildplan-maven-plugin</artifactId>
                    <version>${buildplan.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>fast</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-resources-plugin</artifactId>
                            <executions>
                                <!-- binding a plugin goal to a non-existent phase will
                                        disable the execution of the plugin goal -->
                                <execution>
                                    <id>default-resources</id>
                                    <phase>none</phase>
                                </execution>
                                <execution>
                                    <id>default-testResources</id>
                                    <phase>none</phase>
                                </execution>
                            </executions>
                        </plugin>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-compiler-plugin</artifactId>
                            <executions>
                                <execution>
                                    <id>default-testCompile</id>
                                    <phase>none</phase>
                                </execution>
                            </executions>
                        </plugin>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <executions>
                                <execution>
                                    <id>default-test</id>
                                    <phase>none</phase>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildplan-maven-plugin</artifactId>
                <configuration>
                    <showLifecycles>true</showLifecycles>
                </configuration>
            </plugin>
        </plugins>
    </reporting>
</project>
