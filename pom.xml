<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.self.nyg</groupId>
    <artifactId>maven-basics</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <!-- property used by the maven-resources-plugin, removes a warning -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- user property for the maven-compiler-plugin, defines the java version to use -->
        <!-- can also be put in the plugin configuration -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    </properties>

    <build>
        <!-- use latest version of plugins -->
        <pluginManagement>
            <!-- by default, 7 plugin goals are bound to 7 phases of the default lifecycle -->
            <plugins>
                <plugin>
                    <!-- https://github.com/apache/maven-resources-plugin/releases -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.0</version>
                    <executions>
                        <!-- binding a plugin goal to an non-existent phase will disable the execution of the plugin goal -->
                        <execution>
                            <id>default-resources</id>
                            <phase>none</phase>
                        </execution>
                        <execution>
                            <id>default-testResources</id>
                            <phase>none</phase>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <!-- changelog: https://github.com/apache/maven-compiler-plugin/releases -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.10.1</version>
                    <executions>
                        <!-- binding a plugin goal to an non-existent phase will disable the execution of the plugin goal -->
                        <execution>
                            <id>default-testCompile</id>
                            <phase>none</phase>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <!-- changelog: https://github.com/apache/maven-surefire/releases -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.0.0-M7</version>
                    <executions>
                        <execution>
                            <id>default-test</id>
                            <phase>none</phase>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <!-- changelog: https://github.com/apache/maven-jar-plugin/releases -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                    <configuration>
                        <!-- needed to make the jar executable with java -jar target/*.jar -->
                        <archive>
                            <manifest>
                                <mainClass>edu.self.nyg.maven.basics.Main</mainClass>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
